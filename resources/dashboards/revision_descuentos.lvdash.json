{
  "datasets": [
    {"name":"operacion","displayName":"Descuentos diarios","queryLines":["SELECT dt, CONCAT(COALESCE(Tienda, 'Tienda sin nombre'), ' · ', LocationId) AS tienda,\n","       COALESCE(Canal, 'Sin canal') AS canal, tipo_pago, tickets, venta_bruta, descuento\n","FROM gold_kpis_diarios"]},
    {"name":"revision","displayName":"Tickets y motivos de revisión","queryLines":["SELECT s.dt, CONCAT(COALESCE(l.Tienda, 'Tienda sin nombre'), ' · ', s.LocationId) AS tienda,\n","       COALESCE(c.Canal, 'Sin canal') AS canal, s.tipo_pago, CAST(s.CheckId AS STRING) AS ticket,\n","       s.score, s.prioridad_dia, s.prioridad_por_monto, round(s.descuento, 2) AS descuento_usd,\n","       round(100 * s.tasa_ticket, 2) AS pct_ticket, round(100 * s.tasa_referencia, 2) AS pct_contexto,\n","       s.tickets_referencia, s.grupo_referencia, s.motivos, s.con_advertencia, s.publicado_en\n","FROM gold_revision_descuentos s\n","LEFT JOIN silver_locations l ON s.LocationId = l.LocationId\n","LEFT JOIN silver_revenue_centers c ON s.CheckRevenueCenterId = c.CheckRevenueCenterId\n","WHERE s.prioridad_dia <= 20 AND s.score >= 2\n","ORDER BY s.dt DESC, s.prioridad_dia"]},
    {"name":"calidad","displayName":"Última actualización y controles","queryLines":["SELECT q.fecha_corte AS ultimo_dia_ingestado, s.ultimo_dia_evaluado, q.calculado_en AS refresco_pipeline,\n","       s.publicado_en AS publicacion_modelo, q.tickets AS tickets_admitidos,\n","       coalesce(q.tickets_admitidos_con_advertencia, 0) AS tickets_con_advertencia,\n","       q.registros_rescatados AS registros_en_cuarentena,\n","       q.tickets_propina_desconocida AS tickets_sin_propina_observable,\n","       q.lineas_sin_item_id, q.llaves_duplicadas,\n","       round(100 * q.pct_tickets_conciliados, 5) AS pct_conciliacion_evaluable,\n","       round(100 * try_divide(q.tickets - q.tickets_propina_desconocida, q.tickets), 5) AS pct_cobertura_conciliacion\n","FROM gold_calidad_datos q\n","CROSS JOIN (SELECT max(dt) AS ultimo_dia_evaluado, max(publicado_en) AS publicado_en\n","            FROM gold_revision_descuentos) s"]},
    {"name":"excepciones","displayName":"Incidencias por archivo","queryLines":["SELECT dt, archivo, estado, motivo, registros\n","FROM gold_incidencias_ingesta\n","ORDER BY dt DESC, registros DESC"]}
  ],
