{
  "datasets": [
    {
      "name": "operacion",
      "displayName": "Descuentos diarios",
      "queryLines": [
        "SELECT dt, 'Real' AS origen, CONCAT(COALESCE(Tienda, 'Tienda sin nombre'), ' · ', LocationId) AS tienda,\n       COALESCE(Canal, 'Sin canal') AS canal, tipo_pago, tickets, venta_bruta, descuento\nFROM gold_kpis_diarios"
      ]
    },
    {
      "name": "revision",
      "displayName": "Tickets y motivos de revisión",
      "queryLines": [
        "SELECT s.dt, CONCAT(COALESCE(l.Tienda, 'Tienda sin nombre'), ' · ', s.LocationId) AS tienda,\n       COALESCE(c.Canal, 'Sin canal') AS canal, s.tipo_pago, CAST(s.CheckId AS STRING) AS ticket,\n       s.score, s.prioridad_dia, s.prioridad_por_monto, round(s.descuento, 2) AS descuento_usd,\n       round(100 * s.tasa_ticket, 2) AS pct_ticket, round(100 * s.tasa_referencia, 2) AS pct_contexto,\n       s.tickets_referencia, s.grupo_referencia, s.motivos, s.publicado_en,\n       concat_ws(' · ',\n         IF(s.puntos_contexto > 0, concat('Tasa inusual ', s.puntos_contexto), NULL),\n         IF(s.puntos_autoaprobado > 0, concat('Autoaprobación ', s.puntos_autoaprobado), NULL),\n         IF(s.puntos_sin_gerente > 0, concat('Sin gerente ', s.puntos_sin_gerente), NULL),\n         IF(s.puntos_duracion > 0, concat('4 h+ ', s.puntos_duracion), NULL)) AS desglose,\n       round(s.z_tasa, 1) AS desviaciones,\n       CASE WHEN s.con_advertencia THEN 'Sí' ELSE 'No' END AS advertencia_datos,\n       coalesce(nullif(concat_ws(', ', k._dq_warnings), ''), '—') AS detalle_advertencia,\n       'Real' AS origen\nFROM gold_revision_descuentos s\nLEFT JOIN silver_locations l ON s.LocationId = l.LocationId\nLEFT JOIN silver_revenue_centers c ON s.CheckRevenueCenterId = c.CheckRevenueCenterId\nLEFT JOIN silver_checks k ON k.dt = s.dt AND k.LocationId = s.LocationId AND k.CheckId = s.CheckId\nWHERE s.prioridad_dia <= 20 AND s.score >= 2\nORDER BY s.dt DESC, s.prioridad_dia"
      ]
    },
    {
      "name": "calidad",
      "displayName": "Última actualización y controles",
      "queryLines": [
        "SELECT q.fecha_corte AS ultimo_dia_ingestado, s.ultimo_dia_evaluado, q.calculado_en AS refresco_pipeline,\n",
        "       s.publicado_en AS publicacion_modelo, q.tickets AS tickets_admitidos,\n",
        "       coalesce(q.tickets_admitidos_con_advertencia, 0) AS tickets_con_advertencia,\n",
        "       q.registros_rescatados AS registros_en_cuarentena,\n",
        "       q.tickets_propina_desconocida AS tickets_sin_propina_observable,\n",
        "       q.lineas_sin_item_id, q.llaves_duplicadas,\n",
        "       round(100 * q.pct_tickets_conciliados, 5) AS pct_conciliacion_evaluable,\n",
        "       round(100 * try_divide(q.tickets - q.tickets_propina_desconocida, q.tickets), 5) AS pct_cobertura_conciliacion\n",
        "FROM gold_calidad_datos q\n",
        "CROSS JOIN (SELECT max(dt) AS ultimo_dia_evaluado, max(publicado_en) AS publicado_en\n",
        "            FROM gold_revision_descuentos) s"
      ]
    },
    {
      "name": "excepciones",
      "displayName": "Incidencias por archivo",
      "queryLines": [
        "SELECT dt, archivo, estado, motivo, registros\n",
        "FROM gold_incidencias_ingesta\n",
        "ORDER BY dt DESC, registros DESC"
      ]
    }
  ],
